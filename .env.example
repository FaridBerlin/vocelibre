# VoceLibre runs entirely on your machine. There is no account and no backend,
# so nothing here is required — every value below is optional.

# Optional: UI language for app interface and menus (en, es, fr, de, pt, it, ja, ru, zh-CN, zh-TW)
UI_LANGUAGE=en

# Optional: dictation language for better transcription accuracy.
# Leave empty for auto-detection, or use codes like 'en', 'es', 'fr'.
LANGUAGE=

# Optional: local transcription engine and model.
# LOCAL_TRANSCRIPTION_PROVIDER=nvidia
# PARAKEET_MODEL=parakeet-tdt-0.6b-v3
# LOCAL_WHISPER_MODEL=base

# Optional: API keys for a self-hosted OpenAI-compatible endpoint, if the one
# you run requires a credential. Set only the scopes you point at your server.
# CUSTOM_TRANSCRIPTION_API_KEY=
# CUSTOM_CLEANUP_API_KEY=
# CHAT_AGENT_CUSTOM_API_KEY=
# DICTATION_AGENT_CUSTOM_API_KEY=
# NOTE_FORMATTING_CUSTOM_API_KEY=
# TRANSLATION_CUSTOM_API_KEY=

# Optional: calendar OAuth client IDs, if you connect Google or Microsoft
# Calendar with your own app registration.
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# MICROSOFT_CALENDAR_CLIENT_ID=

# Optional: debug logging
# OPENWHISPR_LOG_LEVEL=debug
